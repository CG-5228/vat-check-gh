{
  "name": "vat-check-gh",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "pnpm notices && tsx scripts/validate-data.ts && next build && tsx scripts/postbuild.ts",
    "start": "serve out -l 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:build": "tsx scripts/build-merchants.ts",
    "data:check": "tsx scripts/check-source-freshness.ts",
    "lighthouse": "lhci autorun",
    "test:coverage": "vitest run --coverage",
    "test:worker": "node --test scripts/test-service-worker.mjs",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "fuse.js": "7.5.0",
    "lucide-react": "1.61.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@fontsource/instrument-sans": "5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "fast-check": "4.10.2",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.31",
      "tmp@<0.2.7": "0.2.7",
      "@lhci/cli>uuid": "11.1.1",
      "compression@<1.8.2": "1.8.2",
      "basic-ftp@<6.2.1": "6.2.1",
      "@opentelemetry/api": "1.9.0",
      "proxy-agent": "8.0.1",
      "lighthouse": "13.5.0"
    }
  }
}
