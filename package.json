{
  "name": "vat-check-gh",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "tsx scripts/validate-data.ts && next build && tsx scripts/postbuild.ts",
    "start": "serve out -l 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:build": "tsx scripts/build-merchants.ts",
    "data:check": "tsx scripts/check-source-freshness.ts",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource/dm-sans": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-toggle-group": "latest",
    "fuse.js": "latest",
    "lucide-react": "latest",
    "next": "15",
    "react": "19",
    "react-dom": "19",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "15",
    "fast-check": "latest",
    "pdfjs-dist": "latest",
    "prettier": "latest",
    "serve": "latest",
    "tailwindcss": "4",
    "tsx": "latest",
    "typescript": "5",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "type": "module"
}
